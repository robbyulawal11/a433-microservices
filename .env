# Port yang digunakan HTTP server shipping service (sesuai ketentuan, biarkan bernilai 3001)
PORT=3001
# Alamat URL RabbitMQ server via protokol AMQP; nilai default untuk pengembangan di local.
# Saat berjalan di Kubernetes, nilai ini akan di-override oleh env pada Deployment manifest
# menjadi amqp://rabbitmq:5672 (nama Kubernetes Service milik RabbitMQ).
AMQP_URL="amqp://localhost:5672"
